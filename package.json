{
  "name": "fairshift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "description": "FairShift PayPal sandbox inbound vertical slice",
  "license": "MIT",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "reference:load": "node --env-file-if-exists=.env.local --import tsx scripts/load-reference-history.ts",
    "zettle:probe": "node --env-file-if-exists=.env.local --import tsx scripts/zettle-live-probe.ts",
    "smoke:manager": "tsx scripts/smoke-manager.ts"
  },
  "dependencies": {
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@7.3.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
