        "sale_transactions_demo_provenance_check": {
          "name": "sale_transactions_demo_provenance_check",
          "value": "\"sale_transactions\".\"source\" != 'DEMO_SEEDED' or (\n      \"sale_transactions\".\"paypal_order_id\" is null and \"sale_transactions\".\"paypal_capture_id\" is null and\n      \"sale_transactions\".\"paypal_custom_id\" is null and \"sale_transactions\".\"provider_created_at\" is null and\n      \"sale_transactions\".\"provider_updated_at\" is null and \"sale_transactions\".\"reconciled_at\" is null and\n      \"sale_transactions\".\"verification_state\" = 'PENDING' and \"sale_transactions\".\"reconciliation_state\" = 'NOT_RECONCILED' and\n      \"sale_transactions\".\"provider_status\" = 'DEMO_SEEDED'\n    )"
        },
        "sale_transactions_currency_code_check": {
          "name": "sale_transactions_currency_code_check",
          "value": "char_length(\"sale_transactions\".\"currency_code\") = 3"
        },
        "sale_transactions_amount_nonnegative": {
          "name": "sale_transactions_amount_nonnegative",
