# PostgreSQL connection used only by the server and migration command.
DATABASE_URL=

# Public application origin used to build PayPal approval return/cancel URLs.
APP_BASE_URL=http://localhost:3000

# This package intentionally accepts only the sandbox environment.
PAYPAL_ENV=sandbox

# Incentive Payouts REST uses Sandbox only; omitted means sandbox.
PAYPAL_ENVIRONMENT=sandbox

# Obtain these from the PayPal Developer Dashboard sandbox app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Registered webhook ID for POST /api/webhooks/paypal (not the client ID).
PAYPAL_WEBHOOK_ID=

# Fixed technical proof amount; USD is supported by the PayPal REST currency list.
PAYPAL_SANDBOX_CURRENCY=USD
PAYPAL_SANDBOX_AMOUNT=5.00

# Server-only OpenAI integration used for manager operational assessment.
# Never expose this key to client code.
OPENAI_API_KEY=

# Optional model override for the bounded operational assessment.
OPENAI_MODEL=gpt-6-luna

# Transactional email (one provider). Missing either keeps delivery UNCONFIGURED.
# Requires a verified sender/domain in Resend. Never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
EMAIL_FROM=

# Existing PayPal Sandbox app, separate organisation SaaS billing plan/webhook.
# Create/approve one plan in the sandbox dashboard; this application does not set pricing.
PAYPAL_SUBSCRIPTION_PLAN_ID=
# Registered for POST /api/webhooks/paypal-subscriptions; separate from capture webhook.
PAYPAL_SUBSCRIPTION_WEBHOOK_ID=

# Operator is a separately provisioned verified identity; comma-separated auth user UUIDs.
# Public registration and organisation ownership never grant Operator access.
FAIRSHIFT_OPERATOR_USER_IDS=

# Optional scheduled POST /api/notifications/dispatch bearer secret (at least 32 chars).
# Schedule outside the app. Missing secret disables this endpoint.
NOTIFICATIONS_DISPATCH_SECRET=
# Production requires APP_BASE_URL=https://your-fairshift-domain for email/PayPal links.
