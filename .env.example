# PostgreSQL connection used only by the server and migration command.
DATABASE_URL=

# Public application origin used to build PayPal approval return/cancel URLs.
APP_BASE_URL=http://localhost:3000

# This package intentionally accepts only the sandbox environment.
PAYPAL_ENV=sandbox

# Incentive Payouts REST uses Sandbox only; omitted means sandbox.
PAYPAL_ENVIRONMENT=sandbox

# Obtain these from the PayPal Developer Dashboard sandbox app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Registered webhook ID for POST /api/webhooks/paypal (not the client ID).
PAYPAL_WEBHOOK_ID=

# Fixed technical proof amount; USD is supported by the PayPal REST currency list.
PAYPAL_SANDBOX_CURRENCY=USD
PAYPAL_SANDBOX_AMOUNT=5.00

# Server-only OpenAI integration used for manager operational assessment.
# Never expose this key to client code.
OPENAI_API_KEY=

# Optional model override for the bounded operational assessment.
OPENAI_MODEL=gpt-6-luna

# Seals merchant commerce credentials at rest: 32 random bytes, base64.
# Generate with: openssl rand -base64 32. Missing or invalid disables connections.
COMMERCE_CREDENTIAL_KEY=
# Square Sandbox commerce. Only "sandbox" is accepted; anything else is not configured.
SQUARE_ENVIRONMENT=
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
# Set to "enabled" to offer the Sandbox demo tools. Needs a Sandbox connection as well.
FAIRSHIFT_DEMO_TOOLS=
# Public one-click demo. Off unless enabled and every value below is valid. Keep off during a genuine rehearsal.
FAIRSHIFT_PUBLIC_DEMO=
FAIRSHIFT_DEMO_ORGANISATION_ID=
FAIRSHIFT_DEMO_OWNER_MEMBERSHIP_ID=
FAIRSHIFT_DEMO_MANAGER_MEMBERSHIP_ID=
FAIRSHIFT_DEMO_WORKER_MEMBERSHIP_ID=

# Transactional email (one provider). Missing either keeps delivery UNCONFIGURED.
# Requires a verified sender/domain in Resend. Never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=
EMAIL_FROM=

# Existing PayPal Sandbox app, separate organisation SaaS billing plan/webhook.
# Four distinct active Sandbox USD plans matching the server catalogue (30-day free trial, then
# Venue US$30.17/month or US$301.73/year; Group US$69.48/month or US$694.76/year: the Owner's USD
# amounts for R499/R4,990 and R1,149/R11,490 incl. VAT). Create them with
# scripts/provision-paypal-subscriptions.ts. Earlier GBP plans still reconcile but can't be checked out.
# Checkout verifies provider price/cadence before creating a subscription.
# A missing/invalid mapping disables only that option; duplicate mappings fail closed.
PAYPAL_SINGLE_OUTLET_MONTHLY_PLAN_ID=
PAYPAL_SINGLE_OUTLET_ANNUAL_PLAN_ID=
PAYPAL_MULTI_OUTLET_MONTHLY_PLAN_ID=
PAYPAL_MULTI_OUTLET_ANNUAL_PLAN_ID=
# Registered for POST /api/webhooks/paypal-subscriptions; separate from capture webhook.
PAYPAL_SUBSCRIPTION_WEBHOOK_ID=

# Operator is a separately provisioned verified identity; comma-separated auth user UUIDs.
# Public registration and organisation ownership never grant Operator access.
FAIRSHIFT_OPERATOR_USER_IDS=

# Optional scheduled POST /api/notifications/dispatch bearer secret (at least 32 chars).
# Schedule outside the app. Missing secret disables this endpoint.
NOTIFICATIONS_DISPATCH_SECRET=
# Production requires APP_BASE_URL=https://your-fairshift-domain for email/PayPal links.

# Optional recipient for the Enterprise contact link (no automated email is sent).
FAIRSHIFT_ENTERPRISE_CONTACT_EMAIL=

# Optional. Ticketmaster Discovery API key for events listed within 3 km of a location.
# Without it, listed events are unavailable and Manager-entered events still work.
TICKETMASTER_API_KEY=

# Scheduled feeds. On server start and every few hours, FairShift refreshes weather for every demo
# location, South Africa's public-holiday feed (Nager.Date) and the ECB reference rate. Set to "off"
# to stop all of them.
FAIRSHIFT_SCHEDULED_FEEDS=
# AI local intelligence (OpenAI web search): one call per demo location at about 05:00 (every
# category) and about 17:00 (short-notice check), South African time, with one retry after a minute
# only after HTTP 429 or no response. On by default only in HOSTED_SANDBOX_DEMO; "on" or "off" overrides.
FAIRSHIFT_LOCAL_INTELLIGENCE_SCHEDULE=
# Model calls per organisation per day for local intelligence (default 20). Runs stop at the cap.
# Retries and manual runs (scripts/local-intelligence.ts) count toward it; the feeds above don't.
FAIRSHIFT_LOCAL_INTEL_DAILY_CAP=

# Per-business PayPal credentials at rest (Owner instruction, 11 Nov 2026): 32 random bytes, base64.
# Generate with: openssl rand -base64 32. Must be identical locally and on the host, and never changed
# once business credentials are stored.
FAIRSHIFT_CREDENTIALS_KEY=

# Deployment (server-only). Anything other than HOSTED_SANDBOX_DEMO is treated as a live customer
# deployment, where PayPal payouts, subscriptions and the Pay Agent stay closed.
FAIRSHIFT_DEPLOYMENT_MODE=
# HOSTED_SANDBOX_DEMO only: the demo business's organisation ID. Without a valid one, Sandbox payments stay closed.
FAIRSHIFT_SANDBOX_ORGANISATION_ID=
# Unset: every business may use Sandbox payouts and subscriptions (with daily caps). DEMO_ONLY: only the demo business.
FAIRSHIFT_SANDBOX_SCOPE=
# "business": each business pays from its own connected PayPal Sandbox app (Business settings > Payouts);
# with none connected, its payouts are refused. Unset or anything else: the platform app above.
FAIRSHIFT_PAYOUT_SENDER=
# The Pay Agent sends nothing to PayPal itself unless this is "false" (dry run otherwise).
FAIRSHIFT_PAY_AGENT_DRY_RUN=
# Planning cache: on by default in production; "on" or "off" overrides.
FAIRSHIFT_PLANNING_CACHE=
# Development only: "enabled" shows tip statement links without email.
FAIRSHIFT_DEV_STATEMENT_LINKS=
# Development only: "enabled" plus an ERRPYO code sends one PayPal Payouts negative-test note. Never in production.
FAIRSHIFT_PAYPAL_NEGATIVE_TESTS=
FAIRSHIFT_PAYPAL_NEGATIVE_TEST_CODE=

# Scripts only. Demo account password for scripts/provision-sa-demo.ts (pnpm demo:sa).
FAIRSHIFT_DEMO_ACCOUNT_PASSWORD=
# Scripts only, for scripts/seed-sa-runtime.ts: local demo password and an optional Sandbox receiving account.
FAIRSHIFT_LOCAL_DEMO_PASSWORD=
FAIRSHIFT_LOCAL_SANDBOX_RECIPIENT=
