{
  "info": {
    "name": "FairShift PayPal Sandbox negative tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "PayPal Sandbox only. Negative testing must be enabled on the platform app's Sandbox business account. Each request asserts PayPal's documented error name and the HTTP status PayPal returned on 7 Nov 2026; differences fail and are recorded. Generated by build-fairshift-paypal.mjs."
  },
  "item": [
    {
      "name": "POST /v1/oauth2/token → 200",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/v1/oauth2/token",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{client_secret}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('host is the PayPal Sandbox', () => pm.expect(pm.request.url.getHost()).to.eql('api-m.sandbox.paypal.com'));",
              "pm.test('HTTP 200 (got ' + pm.response.code + ')', () => pm.expect(pm.response.code).to.eql(200));",
              "const t = pm.response.json().access_token; pm.environment.set('access_token', t); pm.test('token returned', () => pm.expect(!!t).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /v1/payments/payouts · note ERRPYO005 → 422 INSUFFICIENT_FUNDS",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/v1/payments/payouts",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "PayPal-Request-Id",
            "value": "FS-NEG-ERRPYO005-{{$timestamp}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sender_batch_header\": {\n    \"sender_batch_id\": \"FS-NEG-ERRPYO005-{{$timestamp}}\",\n    \"email_subject\": \"FairShift Sandbox negative test\"\n  },\n  \"items\": [\n    {\n      \"recipient_type\": \"EMAIL\",\n      \"amount\": {\n        \"value\": \"1.00\",\n        \"currency\": \"USD\"\n      },\n      \"receiver\": \"payouts-simulator-receiver@paypal.com\",\n      \"note\": \"ERRPYO005\",\n      \"sender_item_id\": \"FS-NEG-I-ERRPYO005\"\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('host is the PayPal Sandbox', () => pm.expect(pm.request.url.getHost()).to.eql('api-m.sandbox.paypal.com'));",
              "let body = {}; try { body = pm.response.json(); } catch (e) {}",
              "const item = (body.items && body.items[0]) || {};",
              "const name = body.name || (body.errors && body.errors.name) || (item.errors && item.errors.name) || null;",
              "const issue = (body.details && body.details[0] && body.details[0].issue) || null;",
              "const status = body.transaction_status || item.transaction_status || (body.batch_header && body.batch_header.batch_status) || body.status || null;",
              "console.log(JSON.stringify({ code: 'ERRPYO005', http: pm.response.code, name, issue, status, batchId: (body.batch_header && body.batch_header.payout_batch_id) || body.payout_batch_id || null, debugId: body.debug_id || null }));",
              "pm.test('HTTP 422 (got ' + pm.response.code + ')', () => pm.expect(pm.response.code).to.eql(422));",
              "pm.test('error name INSUFFICIENT_FUNDS (got ' + name + ')', () => pm.expect(name).to.eql('INSUFFICIENT_FUNDS'));"
            ]
          }
        }
      ]
    },
